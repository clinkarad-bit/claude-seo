{
  "name": "background-remover",
  "version": "1.0.0",
  "description": "KI-basiertes Tool zum Entfernen von Bildhintergruenden",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.background-remover.app",
    "productName": "Background Remover",
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "node_modules/**/*"
    ],
    "extraResources": []
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.5.0"
  }
}
