{
  "name": "COVAGO Setup - Google Drive Ordner anlegen",
  "nodes": [
    {
      "parameters": {},
      "id": "setup-001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-200, 300],
      "notesInFlow": true,
      "notes": "1x klicken → alle Ordner werden automatisch angelegt"
    },
    {
      "parameters": {
        "jsCode": "// Ordnerstruktur definieren\nreturn [{\n  json: {\n    kunde: 'COVAGO',\n    root_folder_name: 'Content Pipeline',\n    subfolders: ['Entwurf', 'Review', 'Freigegeben', 'WordPress Angelegt']\n  }\n}];"
      },
      "id": "setup-002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 300],
      "notesInFlow": true,
      "notes": "Kunden-Name und Ordnerstruktur definieren"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.root_folder_name }}\",\n  \"mimeType\": \"application/vnd.google-apps.folder\"\n}",
        "options": {}
      },
      "id": "setup-003",
      "name": "Create Root: Content Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "CREDENTIAL_GOOGLE",
          "name": "Google OAuth2"
        }
      },
      "notesInFlow": true,
      "notes": "Hauptordner 'Content Pipeline' in Google Drive erstellen"
    },
    {
      "parameters": {
        "jsCode": "const rootId = $input.first().json.id;\nconst kunde = $('Config').first().json.kunde;\nreturn [{ json: { root_folder_id: rootId, kunde: kunde } }];"
      },
      "id": "setup-004",
      "name": "Extract Root ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.kunde }}\",\n  \"mimeType\": \"application/vnd.google-apps.folder\",\n  \"parents\": [\"{{ $json.root_folder_id }}\"]\n}",
        "options": {}
      },
      "id": "setup-005",
      "name": "Create Folder: COVAGO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "CREDENTIAL_GOOGLE",
          "name": "Google OAuth2"
        }
      },
      "notesInFlow": true,
      "notes": "Kunden-Unterordner 'COVAGO' erstellen"
    },
    {
      "parameters": {
        "jsCode": "const kundeId = $input.first().json.id;\nconst rootId = $('Extract Root ID').first().json.root_folder_id;\nreturn [{ json: { kunde_folder_id: kundeId, root_folder_id: rootId } }];"
      },
