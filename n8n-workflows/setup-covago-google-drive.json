        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"WordPress Angelegt\",\n  \"mimeType\": \"application/vnd.google-apps.folder\",\n  \"parents\": [\"{{ $json.kunde_folder_id }}\"]\n}",
        "options": {}
      },
      "id": "setup-010",
      "name": "Create: WordPress Angelegt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 580],
      "credentials": {
        "oAuth2Api": {
          "id": "CREDENTIAL_GOOGLE",
          "name": "Google OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Alle Ordner-IDs zusammenfassen\nconst entwurfId = $('Create: Entwurf').first().json.id;\nconst reviewId = $('Create: Review').first().json.id;\nconst freigegebenId = $('Create: Freigegeben').first().json.id;\nconst wpId = $('Create: WordPress Angelegt').first().json.id;\nconst kundeId = $('Extract Kunde ID').first().json.kunde_folder_id;\nconst rootId = $('Extract Kunde ID').first().json.root_folder_id;\n\nconst output = {\n  success: true,\n  message: '✅ Alle Google Drive Ordner für COVAGO wurden erstellt!',\n  ordner_ids: {\n    root_content_pipeline: rootId,\n    covago_hauptordner: kundeId,\n    entwurf: entwurfId,\n    review: reviewId,\n    freigegeben: freigegebenId,\n    wordpress_angelegt: wpId\n  },\n  anleitung: [\n    '--- DIESE IDs IN DIE WORKFLOWS EINTRAGEN ---',\n    '',\n    'Workflow 00 (Keyword Research):',\n    `  google_drive_folder_id = ${kundeId}`,\n    '',\n    'Workflow 01b (Content Writer):',\n    `  google_drive_folder_id = ${entwurfId}`,\n    '',\n    'Workflow 02 (Review Flow):',\n    `  entwurf_folder_id = ${entwurfId}`,\n    `  review_folder_id = ${reviewId}`,\n    '',\n    'Workflow 03 (Freigabe Flow):',\n    `  review_folder_id = ${reviewId}`,\n    `  freigegeben_folder_id = ${freigegebenId}`,\n    '',\n    'Workflow 04 (WordPress Publish):',\n    `  freigegeben_folder_id = ${freigegebenId}`,\n    `  wordpress_folder_id = ${wpId}`\n  ]\n};\n\nreturn [{ json: output }];"
      },
      "id": "setup-011",
      "name": "Summary: Alle Ordner-IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300],
      "notesInFlow": true,
      "notes": "Zeigt alle erstellten Ordner-IDs + wo sie eingetragen werden müssen"
    }
  ],
