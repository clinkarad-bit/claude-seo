    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.clickup.com/api/v2/task/{{ $('ClickUp Webhook Trigger').item.json.body.task_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4aaa-b111-000000000004",
      "name": "Get Task Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wwbq6Yxnr2EpmrFv",
          "name": "ClickUp API"
        }
      },
      "notes": "Fetch the full ClickUp task to access custom fields, including 'Link zum Beitrag'."
    },
    {
      "parameters": {
        "jsCode": "// Extract the Google Doc ID from the 'Link zum Beitrag' custom field\nconst task = $input.first().json;\nconst customFields = task.custom_fields || [];\n\n// Find the custom field named 'Link zum Beitrag'\nconst linkField = customFields.find(\n  (field) => field.name === 'Link zum Beitrag'\n);\n\nif (!linkField || !linkField.value) {\n  throw new Error(\n    \"Custom field 'Link zum Beitrag' not found or empty on task: \" + task.id\n  );\n}\n\nconst url = typeof linkField.value === 'string' ? linkField.value : linkField.value.url || linkField.value;\n\n// Extract Google Doc ID from various URL formats:\n// https://docs.google.com/document/d/{ID}/edit\n// https://drive.google.com/file/d/{ID}/view\n// https://docs.google.com/document/d/{ID}\nconst match = url.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n\nif (!match) {\n  throw new Error('Could not extract Google Doc ID from URL: ' + url);\n}\n\nconst docId = match[1];\nconst taskName = task.name || '';\n\nreturn [\n  {\n    json: {\n      doc_id: docId,\n      doc_url: url,\n      task_id: task.id,\n      task_name: taskName\n    }\n  }\n];\n"
      },
      "id": "a1b2c3d4-1111-4aaa-b111-000000000005",
      "name": "Extract Doc ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "notes": "Parse the Google Doc/Drive URL from the 'Link zum Beitrag' custom field and extract the file ID."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.doc_id }}?addParents={{ $('Config').item.json.freigegeben_folder_id }}&removeParents={{ $('Config').item.json.review_folder_id }}",
        "authentication": "predefinedCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        },
        "nodeCredentialType": "googleOAuth2Api"
      },
      "id": "a1b2c3d4-1111-4aaa-b111-000000000006",
      "name": "Google Drive: Move to Freigegeben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
