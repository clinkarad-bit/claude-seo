          "id": "wwbq6Yxnr2EpmrFv",
          "name": "ClickUp API"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "google_sheet_id",
              "value": "YOUR_GOOGLE_SHEET_ID"
            },
            {
              "name": "sheet_name",
