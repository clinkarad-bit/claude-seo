{
  "name": "02 - Review Flow (ClickUp → Google Drive)",
  "nodes": [
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000001",
              "name": "entwurf_folder_id",
              "value": "YOUR_ENTWURF_FOLDER_ID",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000002",
              "name": "review_folder_id",
              "value": "YOUR_REVIEW_FOLDER_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000001",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        250,
        300
      ],
      "notesInFlow": true,
      "notes": "Konfiguration: Google Drive Ordner-IDs für Entwurf und Review"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clickup-review-webhook",
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000002",
      "name": "ClickUp Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        20,
        300
      ],
      "webhookId": "c2d3e4f5-2002-4b00-a000-000000000001",
      "notesInFlow": true,
      "notes": "Empfängt ClickUp Webhook wenn Task-Status sich ändert"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1b2c3d4-3003-4000-8000-000000000001",
              "leftValue": "={{ $json.body.history_items[0].after.status }}",
              "rightValue": "review beim kunden",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000003",
      "name": "Check Status = REVIEW BEIM KUNDEN",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.clickup.com/api/v2/task/{{ $json.body.task_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "clickUpApi",
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000004",
      "name": "Get ClickUp Task Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        280
      ],
      "credentials": {
        "clickUpApi": {
          "id": "wwbq6Yxnr2EpmrFv",
          "name": "ClickUp API"
        }
      },
      "notesInFlow": true,
      "notes": "Task-Details von ClickUp holen inkl. Custom Fields"
    },
    {
      "parameters": {
        "jsCode": "// Extract \"Link zum Beitrag\" custom field (Google Doc URL)\nconst taskData = $input.first().json;\nconst customFields = taskData.custom_fields || [];\n\n// Find the \"Link zum Beitrag\" custom field\nconst linkField = customFields.find(\n  (f) => f.name === 'Link zum Beitrag' || f.name === 'link zum beitrag'\n);\n\nif (!linkField || !linkField.value) {\n  throw new Error('Custom field \"Link zum Beitrag\" not found or empty on this task.');\n}\n\nconst googleDocUrl = linkField.value;\n\n// Extract the Google Doc/File ID from the URL\n// Supports formats:\n//   https://docs.google.com/document/d/FILE_ID/edit\n//   https://drive.google.com/file/d/FILE_ID/view\n//   https://docs.google.com/document/d/FILE_ID\nconst match = googleDocUrl.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n\nif (!match) {\n  throw new Error(`Could not extract Google Doc ID from URL: ${googleDocUrl}`);\n}\n\nconst fileId = match[1];\n\n// Get folder IDs from Config node\nconst configItems = $('Config').first().json;\nconst entwurfFolderId = configItems.entwurf_folder_id;\nconst reviewFolderId = configItems.review_folder_id;\n\nreturn [\n  {\n    json: {\n      fileId,\n      googleDocUrl,\n      taskId: taskData.id,\n      taskName: taskData.name,\n      entwurfFolderId,\n      reviewFolderId\n    }\n  }\n];"
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000005",
      "name": "Extract Google Doc ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        280
      ],
      "notesInFlow": true,
      "notes": "Google Doc ID aus der URL extrahieren + Ordner-IDs aus Config laden"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.fileId }}?addParents={{ $json.reviewFolderId }}&removeParents={{ $json.entwurfFolderId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000006",
      "name": "Google Drive: Move to Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        280
      ],
      "credentials": {
        "googleOAuth2Api": {
          "id": "CREDENTIAL_GOOGLE",
          "name": "Google OAuth2"
        }
      },
      "notesInFlow": true,
      "notes": "Google Doc von Entwurf-Ordner in Review-Ordner verschieben"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000003",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000004",
              "name": "message",
              "value": "=Google Doc für Task \"{{ $('Extract Google Doc ID').item.json.taskName }}\" wurde von Entwurf → Review verschoben.",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000005",
              "name": "fileId",
              "value": "={{ $('Extract Google Doc ID').item.json.fileId }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000006",
              "name": "taskId",
              "value": "={{ $('Extract Google Doc ID').item.json.taskId }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0001-4000-8000-000000000007",
              "name": "googleDocUrl",
              "value": "={{ $('Extract Google Doc ID').item.json.googleDocUrl }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000007",
      "name": "Notify: Move Confirmed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1440,
        280
      ],
      "notesInFlow": true,
      "notes": "Bestätigung: Datei wurde erfolgreich verschoben"
    }
  ],
