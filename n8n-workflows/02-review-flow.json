    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.clickup.com/api/v2/task/{{ $json.body.task_id }}",
        "authentication": "genericCredentialType",
        "options": {},
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000004",
      "name": "Get ClickUp Task Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        280
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wwbq6Yxnr2EpmrFv",
          "name": "ClickUp API"
        }
      },
      "notesInFlow": true,
      "notes": "Task-Details von ClickUp holen inkl. Custom Fields"
    },
    {
      "parameters": {
        "jsCode": "// Extract \"Link zum Beitrag\" custom field (Google Doc URL)\nconst taskData = $input.first().json;\nconst customFields = taskData.custom_fields || [];\n\n// Find the \"Link zum Beitrag\" custom field\nconst linkField = customFields.find(\n  (f) => f.name === 'Link zum Beitrag' || f.name === 'link zum beitrag'\n);\n\nif (!linkField || !linkField.value) {\n  throw new Error('Custom field \"Link zum Beitrag\" not found or empty on this task.');\n}\n\nconst googleDocUrl = linkField.value;\n\n// Extract the Google Doc/File ID from the URL\n// Supports formats:\n//   https://docs.google.com/document/d/FILE_ID/edit\n//   https://drive.google.com/file/d/FILE_ID/view\n//   https://docs.google.com/document/d/FILE_ID\nconst match = googleDocUrl.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n\nif (!match) {\n  throw new Error(`Could not extract Google Doc ID from URL: ${googleDocUrl}`);\n}\n\nconst fileId = match[1];\n\n// Get folder IDs from Config node\nconst configItems = $('Config').first().json;\nconst entwurfFolderId = configItems.entwurf_folder_id;\nconst reviewFolderId = configItems.review_folder_id;\n\nreturn [\n  {\n    json: {\n      fileId,\n      googleDocUrl,\n      taskId: taskData.id,\n      taskName: taskData.name,\n      entwurfFolderId,\n      reviewFolderId\n    }\n  }\n];"
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000005",
      "name": "Extract Google Doc ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        280
      ],
      "notesInFlow": true,
      "notes": "Google Doc ID aus der URL extrahieren + Ordner-IDs aus Config laden"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.fileId }}?addParents={{ $json.reviewFolderId }}&removeParents={{ $json.entwurfFolderId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-1001-4a00-b000-000000000006",
      "name": "Google Drive: Move to Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        280
      ],
      "credentials": {
        "googleOAuth2Api": {
          "id": "u6XCIz3Yxbakjrwg",
          "name": "Google account"
        }
      },
      "notesInFlow": true,
      "notes": "Google Doc von Entwurf-Ordner in Review-Ordner verschieben"
    },
    {
