    },
    {
      "id": "dedup-02",
      "name": "Deduplicate Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "jsCode": "// Prevent duplicate executions for the same task\nconst taskId = $('ClickUp Webhook Trigger').item.json.body?.task_id || '';\nconst now = Date.now();\nconst staticData = $getWorkflowStaticData('global');\nconst recentTasks = staticData.recentTasks || {};\n\n// Clean up entries older than 30 seconds\nfor (const [key, timestamp] of Object.entries(recentTasks)) {\n  if (now - timestamp > 30000) delete recentTasks[key];\n}\n\nif (recentTasks[taskId]) return [];  // Duplicate - stop\n\nrecentTasks[taskId] = now;\nstaticData.recentTasks = recentTasks;\nreturn $input.all();"
      }
    }
  ],
